# Public client configuration (safe for browser use)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only; use only inside /api serverless functions
GEMINI_API_KEY=
# Optional model overrides for the CV improvement endpoint; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
